    "@fastify/cors": "^11.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "fastify": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clip-flow/eslint-config": "workspace:^",
    "@clip-flow/jest-preset": "workspace:^",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
