{
  "name": "@clip-flow/database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "build": "tsup",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json",
    "test": "echo \"no unit tests here — schema is validated by 'prisma validate'/'prisma generate' in build\"",
    "test:coverage": "echo \"no unit tests here — schema is validated by 'prisma validate'/'prisma generate' in build\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@clip-flow/eslint-config": "workspace:^",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
